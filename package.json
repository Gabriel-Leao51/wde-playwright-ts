{
  "name": "wde-automation-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript end-to-end suite for the WDE Shop app",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
